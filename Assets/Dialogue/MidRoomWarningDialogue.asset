  m_Script: {fileID: 11500000, guid: 27dd0aa2839e4b6ca5f81a07a66a0d51, type: 3}
  m_Name: MidRoomWarningDialogue
  m_EditorClassIdentifier: 
  sequenceName: Mid Room Warning
  lines:
  - speakerName: "\u573A\u5730\u6280\u5E08"
    content: "\u524D\u9762\u662F\u66F4\u6DF1\u7684\u623F\u95F4\u3002\u602A\u7269\u4E0D\u4F1A\u7B49\u4F60\u6574\u7406\u80CC\u5305\uFF0C\u6240\u4EE5\u8BB0\u5F97\u5148\u770B\u6E05\u695A\u81EA\u5DF1\u7684\u72B6\u6001\u3002"
  - speakerName: "\u573A\u5730\u6280\u5E08"
    content: "\u84DD\u8272\u6280\u529B\u6761\u4F1A\u81EA\u52A8\u6062\u590D\u3002\u4EE5\u540E\u6280\u80FD\u4F1A\u6D88\u8017\u6280\u529B\uFF0C\u73B0\u5728\u5148\u628A\u5B83\u5F53\u6210\u6218\u6597\u8282\u594F\u63D0\u793A\u3002"
  - speakerName: "\u573A\u5730\u6280\u5E08"
    content: "\u5982\u679C\u95E8\u8FD8\u9501\u7740\uFF0C\u5C31\u5148\u6E05\u6389\u623F\u95F4\u91CC\u7684\u654C\u4EBA\u3002Boss
      \u623F\u524D\u4E0D\u8981\u8D2A\u5200\u3002"
